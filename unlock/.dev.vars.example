# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Local testing only: lets ?country=US force the USD price. Never set this in production.
ALLOW_COUNTRY_OVERRIDE=1

# Only needed for the Garmin unlock callback, not for checkout or signature verification.
# GARMIN_OAUTH_KEY=your_garmin_consumer_key
# GARMIN_OAUTH_SECRET=your_garmin_consumer_secret
