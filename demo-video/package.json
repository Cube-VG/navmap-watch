{
  "name": "navmap-demo-video",
  "version": "1.0.0",
  "private": true,
  "description": "NavMap product demo video, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "sounds": "bash scripts/make-sounds.sh",
    "render": "npm run render:landscape && npm run render:vertical",
    "render:landscape": "remotion render NavMapDemo out/navmap-demo.mp4",
    "render:vertical": "remotion render NavMapDemoVertical out/navmap-demo-vertical.mp4",
    "stills": "bash scripts/extract-stills.sh",
    "frames": "node scripts/render-frames.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
