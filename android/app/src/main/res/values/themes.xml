<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NavBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_nav_blue</item>
        <item name="colorPrimaryContainer">@color/color_nav_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/color_nav_blue_on_container</item>
        <item name="colorSecondary">@color/color_charcoal</item>
        <item name="colorSecondaryContainer">@color/color_pearl</item>
        <item name="colorOnSecondaryContainer">@color/color_ink</item>
        <item name="android:colorBackground">@color/color_cream_wash</item>
        <item name="colorSurface">@color/color_canvas_white</item>
        <item name="colorOnSurface">@color/color_ink</item>
        <item name="colorOutline">@color/color_ash</item>
        <item name="colorOutlineVariant">@color/card_stroke_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.NavBridge.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.NavBridge.Button" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.NavBridge.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NavBridge.Card</item>
        <item name="cardBackgroundColor">@color/surface_card_hero_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_light</item>
    </style>

    <style name="Widget.NavBridge.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NavBridge.Card</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_light</item>
    </style>

    <style name="Widget.NavBridge.Card.Terminal" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NavBridge.Card</item>
        <item name="cardBackgroundColor">@color/admin_terminal_bg</item>
    </style>
</resources>
