<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NavBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_nav_blue_dark</item>
        <item name="colorPrimaryContainer">#0B2B61</item>
        <item name="colorOnPrimaryContainer">#D3E3FD</item>
        <item name="colorSecondary">#E3E3E3</item>
        <item name="colorSecondaryContainer">#252830</item>
        <item name="colorOnSecondaryContainer">#E3E3E3</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOutline">@color/text_secondary_dark</item>
        <item name="colorOutlineVariant">@color/card_stroke_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.NavBridge.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NavBridge.Card</item>
        <item name="cardBackgroundColor">@color/surface_card_hero_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
    </style>

    <style name="Widget.NavBridge.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NavBridge.Card</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
    </style>
</resources>
